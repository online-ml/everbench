# Copy this file to .env for local development. Do not commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/everbench
EVERBENCH_MODEL_SIGNING_KEY=replace-with-a-long-random-secret
EVERBENCH_API_KEY=replace-with-a-separate-long-random-secret
# Required to enable automatic weekly Parquet compaction. It must be shared
# durable storage visible to both the worker and web service in production.
# EVERBENCH_ARCHIVE_ROOT=/absolute/path/to/durable/archive
# EVERBENCH_ARCHIVE_AFTER_DAYS=30
# EVERBENCH_ARCHIVE_INTERVAL_SECONDS=3600
# Production: S3-compatible object storage (Cloudflare R2 works directly).
# S3_BUCKET_NAME=everbench
# S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_CA_BUNDLE=/etc/ssl/cert.pem
# EVERBENCH_MODEL_CHECKPOINT_SECONDS=60
# EVERBENCH_MAX_ACTIVE_MODELS_PER_TASK=20
