# Compose publishes Everbench only on the server's loopback interface by
# default. Use an SSH tunnel or reverse proxy. Set 0.0.0.0 only when direct
# access from the LAN is intentional and the server firewall is configured.
EVERBENCH_BIND_ADDRESS=127.0.0.1
EVERBENCH_PORT=8000

# Generate independent values with: openssl rand -hex 32
EVERBENCH_MODEL_SIGNING_KEY=replace-with-a-long-random-secret
EVERBENCH_API_KEY=replace-with-a-separate-long-random-secret

EVERBENCH_TASK_NAMES=wiki-liftwing
EVERBENCH_DB_POOL_SIZE=10
EVERBENCH_ARCHIVE_AFTER_DAYS=7

# Weekly autonomous research needs an OpenAI API key. Leave both unset to run
# the live benchmark without autonomous research.
# EVERBENCH_SCHEDULE_RESEARCH=1
# OPENAI_API_KEY=...

